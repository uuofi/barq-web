# ---------------------------------------------------------------------------
# Public marketing site — runtime configuration.
# Copy to `.env` (dev) / `.env.production` and fill in. Every value here ships
# to the browser: NEVER put a secret in this file. Validation lives in
# src/config/env.ts — a missing/invalid required value fails the build loudly
# instead of producing a silently broken site.
# ---------------------------------------------------------------------------

# Backend API origin. Leave empty in dev to use the Vite proxy (/api → :4000).
VITE_API_BASE_URL=

# Canonical public origin of this site. Required in production: it is the base
# for <link rel="canonical">, Open Graph URLs, sitemap and JSON-LD.
VITE_SITE_URL=https://barq-iq.site

# Deep links to the mobile apps. Empty = the download CTA renders disabled.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
VITE_APK_DOWNLOAD_URL=

# Public contact channels shown in the footer / contact page.
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
VITE_WHATSAPP_NUMBER=

# Analytics. Empty = analytics is a no-op (see src/lib/analytics.ts).
VITE_ANALYTICS_ID=

# Feature flags — 'true' / 'false'. Let a page ship dark without a code change.
VITE_FEATURE_ORDER_TRACKING=false
VITE_FEATURE_LEAD_FORMS=false
